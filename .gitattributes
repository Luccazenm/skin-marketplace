# Line endings
#
# Without this, git warns "LF will be replaced by CRLF" on every commit
# made on Windows, and the same file shows up as modified depending on
# who saved it. Here the repository stays on LF and so does the disk —
# the whole chain (Node, TypeScript, Prisma, Docker) works with LF, and
# converting would only create a difference where the content did not
# change.
* text=auto eol=lf

# Scripts Windows executes need CRLF to work.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: converting line endings here corrupts the file.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.maFile binary

# A generated file: it disappears from diff review, but stays versioned.
pnpm-lock.yaml -diff linguist-generated
