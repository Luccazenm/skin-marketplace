{
  "name": "skin-marketplace",
  "version": "1.0.0",
  "description": "Marketplace de skins de CS2",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "check": "turbo typecheck lint test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev",
    "db:seed": "pnpm --filter backend exec prisma db seed",
    "db:studio": "pnpm --filter backend exec prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "turbo": "^2.10.3"
  }
}
