{
  "$schema": "https://turbo.build/schema.json",

  // turbo does not pass through environment variables that are not
  // declared here. Locally this never showed up, because the variables
  // came from the .env file dotenv reads inside the process — but in CI
  // there is no .env, they come from the environment, and the tests died
  // with "DATABASE_URL is not set".
  //
  // Declaring them in globalEnv also makes turbo invalidate the cache
  // when one of these values changes, which is the right behaviour: a
  // build made pointing at another database is not the same build.
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN_SECONDS",
    "CORS_ORIGIN",
    "API_URL",
    "FRONTEND_URL",
    "COOKIE_SECURE",
    "STEAM_API_KEY"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      // The tests touch Postgres, so the result does not depend on the
      // files alone. Caching would make turbo skip a suite that would
      // start failing after a migration.
      "cache": false
    },
    "typecheck": {}
  }
}
