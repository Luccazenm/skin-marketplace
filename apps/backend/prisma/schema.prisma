generator client {
  provider = "prisma-client-js"
}

// In Prisma 7 the connection string lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// =========================
// USER
// =========================
model User {
  id String @id @default(uuid(7))

  // The system account representing the platform itself. There must be
  // exactly ONE row with isPlatform = true (guaranteed by the seed).
  // It owns the items bought through the fast flow and is the ledger's
  // counterparty: the platform's cash is this account's balance.
  // Every "real users" query has to filter isPlatform = false.
  isPlatform Boolean @default(false)

  // Steam
  steamId        String    @unique
  username       String
  avatarUrl      String?
  profileUrl     String?
  steamCreatedAt DateTime?

  // Wallet (always USD internally)
  balance         Decimal @default(0) @db.Decimal(12, 2)
  displayCurrency String  @default("USD")

  // Contact / account
  email         String? @unique
  emailVerified Boolean @default(false)

  // OUR moderation: we suspended this account. It blocks login.
  isBanned  Boolean @default(false)
  banReason String?

  // ---- Restrictions imposed by STEAM ----
  // Not to be confused with isBanned. Someone banned by Steam is still
  // our customer and still owns what is in custody — they only lose part
  // of the operations. Treating them as banned by us would punish them
  // twice.
  //
  // The two fields below block DIFFERENT things:
  //
  // steamEconomyBan  BANNED    -> neither sends nor receives. No deposit
  //                              and no withdrawal; selling here is the
  //                              only way out.
  //                  PROBATION -> a temporary restriction, treat as
  //                              blocked.
  //
  // steamVacBanned   -> cannot SEND, but RECEIVES normally. That is: no
  //                     deposits, but withdrawals work.
  //                     Recorded as a signal only, it blocks nothing on
  //                     its own: Steam's API does not say which game the
  //                     VAC is from, and a VAC in another game does not
  //                     affect CS2 items.
  steamEconomyBan   SteamEconomyBan @default(NONE)
  steamVacBanned    Boolean         @default(false)
  steamBanCheckedAt DateTime?

  // Trade
  tradeUrl String?

  // Relations
  items        Item[]
  listings     Listing[]
  transactions Transaction[]
  tradeOffers  TradeOffer[]
  purchases    Order[]       @relation("OrderBuyer")
  sales        Order[]       @relation("OrderSeller")

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([steamEconomyBan])
}

/**
 * Mirrors the EconomyBan field of Steam's GetPlayerBans.
 */
enum SteamEconomyBan {
  NONE
  PROBATION
  BANNED
}

// =========================
// SKIN TEMPLATE
// =========================
/// The catalog: one record per item that exists in the game.
///
/// It is the MODEL, not the instance. "AK-47 | Redline (Field-Tested)"
/// is a SkinTemplate; the specific AK with float 0.187 and four stickers
/// is an Item. Price, liquidity and search hang off this, because the
/// market quotes the model — the instance's float adjusts on top of it.
///
/// Each exterior and each variant is its own entry, because each has its
/// own quote: "AK-47 | Redline (Field-Tested)" and "StatTrak™ AK-47 |
/// Redline (Field-Tested)" are different prices.
///
/// ALL tradable types go in, not only weapons: stickers, capsules,
/// agents, charms and cases have their own prices too. Without stickers
/// in the catalog it is impossible to show "the weapon is worth X, each
/// sticker is worth Y" — which is this project's display rule.
model SkinTemplate {
  id String @id @default(uuid(7))

  // Identification
  marketHashName String @unique /// e.g. "StatTrak™ AK-47 | Redline (Field-Tested)"
  rarity         String /// e.g. "Classified"

  /// Where the item comes from: collections and cases. A list because
  /// **a quarter of the catalog comes from more than one origin** —
  /// Karambit | Doppler drops from Chroma, Chroma 2 and Chroma 3; Sport
  /// Gloves | Pandora's Box drops from the Glove Case and the Operation
  /// Hydra Case.
  ///
  /// Storing only one would be an arbitrary choice, and the information
  /// matters beyond display: a skin that drops from three cases has far
  /// more supply than an exclusive one, and supply is an input to
  /// `buyoutEligible`.
  ///
  /// There is no "primary origin": the Karambit is no more from Chroma 3
  /// than from Chroma 1.
  collections String[] @default([])

  /// What kind of item this is. The same classification as the
  /// inventory, so the catalog and the Steam reading agree.
  category ItemCategory @default(OTHER)

  /// Only for things with a pattern of their own: weapons, knives,
  /// gloves.
  ///
  /// Null on stickers, capsules, agents, charms and cases — those have
  /// neither a weapon nor a skin name. They used to be required, which
  /// made it impossible to register anything that was not a weapon.
  weapon   String? /// e.g. "AK-47"
  skinName String? /// e.g. "Redline"

  variant SkinVariant @default(NORMAL)

  /// The SKIN's float range, not the instance's: 73.9% of skins do not
  /// run from 0 to 1. `UMP-45 | Grand Prix` exists only between 0.25 and
  /// 0.35 — that is, only in Field-Tested. Null on items without a
  /// float.
  ///
  /// **It is not needed to display the float**, and the exterior bands
  /// (Factory New 0–0.07, Field-Tested 0.15–0.38…) are global and do not
  /// live here. We keep it for two modest reasons: it validates an
  /// impossible float coming from the inventory, and it unlocks a
  /// float-quality indicator should we ever want one. Zero cost — it
  /// comes ready from the dataset, on 100% of painted skins.
  minFloat Float?
  maxFloat Float?

  /// The item's descriptive text, without HTML.
  ///
  /// It belongs to the MODEL, which is why it lives here and not on the
  /// instance: every AK Redline has the same description. What varies
  /// from one to another — float, pattern, stickers — lives in `Item`.
  description String?

  /// The italic line Valve puts at the end of the description ("Never be
  /// afraid to push it to the limit"). Kept separate because it is
  /// flavour, not information: the storefront may want to highlight it
  /// or leave it out.
  flavorText String?

  // Media
  imageUrl    String?
  inspectLink String?

  // Cached external reference price (display only, overwritten periodically)
  referencePrice   Decimal?  @db.Decimal(12, 2)
  referencePriceAt DateTime?

  // ---- Fast-flow whitelist (discounted buy for resale) ----
  // Criteria: liquidity + a price ceiling. An illiquid item sits locked
  // for 7 days with no way to offload it on another market, so the price
  // risk is real.
  // buyoutEligible is computed by a job, never edited by hand.
  buyoutEligible     Boolean   @default(false)
  buyoutDiscountPct  Decimal?  @db.Decimal(5, 2) // discount applied on purchase
  salesVolume30d     Int? // sales observed in the last 30 days
  liquidityUpdatedAt DateTime?

  items     Item[]
  snapshots PriceSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyoutEligible])
  /// Storefront: "every AK", "every sticker".
  @@index([category])
  @@index([weapon])
  /// GIN, so "everything that drops from Chroma 2" also finds what comes
  /// from other cases alongside it. A plain index is no use on a list
  /// column.
  @@index([collections], type: Gin)
}

// =========================
// PRICE HISTORY
// =========================
// Append-only, like Transaction. Never edit an existing row: each
// reading is a dated fact, and rewriting it would erase the proof of
// what was shown to the user at that moment.
//
// It exists for two reasons that buying data does not solve:
//
// 1. Complaints. "The site showed me US$ 340 and you paid US$ 290" can
//    only be answered if the displayed price was recorded by us. The
//    vendor does not keep what it answered three months ago.
// 2. Charts. Buying a historical archive is expensive and recurring;
//    accumulating our own costs nothing. Except it cannot be recovered
//    later — either we started, or it does not exist.
model PriceSnapshot {
  id String @id @default(uuid(7))

  skinTemplateId String
  skinTemplate   SkinTemplate @relation(fields: [skinTemplateId], references: [id])

  /// Where it came from. Source and market are different things: the
  /// same vendor delivers prices from several markets.
  source PriceSource
  market PriceMarket

  /// Always USD, like the rest of the system. More precision than the
  /// ledger because cheap stickers and charms fall below a cent.
  price Decimal @db.Decimal(14, 4)

  /// The best bid and ask, when the source separates them. The spread
  /// between them is what indicates liquidity — an average hides that.
  bid Decimal? @db.Decimal(14, 4)
  ask Decimal? @db.Decimal(14, 4)

  /// Sales observed in the last 24h, when the source reports it.
  volume24h Int?

  /// When the SOURCE determined the price, not when we stored it. A
  /// vendor serving data from ten minutes ago has to be
  /// distinguishable from one serving it live.
  quotedAt DateTime

  capturedAt DateTime @default(now())

  /// One reading per template, source, market and quoted instant.
  /// Running the job twice does not duplicate the series.
  @@unique([skinTemplateId, source, market, quotedAt])
  /// Chart scan: one template, ordered in time.
  @@index([skinTemplateId, market, quotedAt])
}

enum PriceSource {
  CS2SH
  STEAMWEBAPI
  /// A price formed on our own marketplace, once there is volume.
  INTERNAL
}

enum PriceMarket {
  BUFF163
  YOUPIN
  CSFLOAT
  SKINPORT
  C5GAME
  DMARKET
  WAXPEER
  BITSKINS
  STEAM
  NEXTSKINS
}

enum SkinVariant {
  NORMAL
  STATTRAK
  SOUVENIR
}

// =========================
// ITEM (a real instance)
// =========================
model Item {
  id String @id @default(uuid(7))

  templateId String
  template   SkinTemplate @relation(fields: [templateId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // What this item is. It comes from Steam's Type tag, not from the name.
  category ItemCategory

  // CAUTION: assetId CHANGES on every inventory trade. It is the item's
  // current address on Steam, not its identity — which is why it is not
  // @unique.
  assetId String // the item's current id on Steam (mutable)

  // Only weapons, knives and gloves have a unique pattern. Cases,
  // stickers and agents are fungible: one instance is identical to
  // another, and these fields stay null.
  // A CHECK in the migration guarantees that a category with a unique
  // pattern has all four filled in — a null there would mean an item
  // impossible to identify after a trade.
  //
  // When filled in, the item's stable identity is the combination
  // float + paintSeed + paintIndex + defIndex.
  float      Float?
  paintSeed  Int?
  paintIndex Int?
  defIndex   Int? // defines the weapon itself (immutable)

  // Where the item PHYSICALLY is. Not to be confused with who owns it
  // (ownerId) nor with being sold (Order) — in our flow the item spends
  // almost its whole life sitting in BOT_CUSTODY, sold or not.
  location ItemLocation @default(USER_INVENTORY)
  botId    String? // if it is held by a bot
  bot      Bot?         @relation(fields: [botId], references: [id])

  // Valve's Trade Protection: 7 days every time the item is RECEIVED.
  // While it is in the future, the bot cannot send the item to anyone.
  // Filled in when the bot accepts the deposit trade.
  tradeLockUntil DateTime?

  // How the item entered custody.
  // PLATFORM_BUYOUT = our own stock: we bought at a discount to resell.
  // In that case acquisitionCost is required in practice — without it
  // there is no way to compute margin or tell whether the discount is
  // calibrated.
  acquisitionType ItemAcquisition @default(USER_DEPOSIT)
  acquisitionCost Decimal?        @db.Decimal(12, 2) // in USD, buyout only
  acquiredAt      DateTime?

  applications    ItemApplication[]
  listing         Listing?
  tradeOfferItems TradeOfferItem[]
  orders          Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([templateId])
  @@index([location])
  @@index([botId])
  @@index([assetId]) // lookup when reconciling inventory, but not unique
  @@index([acquisitionType]) // own-stock reporting
  @@index([category])
  // The item's stable identity — used to find it again after a trade
  @@index([defIndex, paintIndex, paintSeed, float])
  // Delivery queue: items releasable from a given moment
  @@index([location, tradeLockUntil])
}

enum ItemAcquisition {
  USER_DEPOSIT // the user deposited it to sell — the item is not ours
  PLATFORM_BUYOUT // we bought it from the user in the fast flow — own stock
}

/**
 * Derived from Steam's Type tag. Granular on purpose: beyond deciding
 * which fields an item needs, this is how the storefront filters.
 * The first eight have a unique pattern (float and paint seed). The rest
 * are fungible — one instance is identical to another.
 */
enum ItemCategory {
  RIFLE
  PISTOL
  SMG
  SNIPER_RIFLE
  SHOTGUN
  MACHINEGUN
  KNIFE
  GLOVES

  /// The Zeus x27. It has a skin, a float and a paint seed like any
  /// weapon, but Valve classifies it separately
  /// ("CSGO_Type_Equipment") and it belongs to none of the families
  /// above.
  EQUIPMENT

  STICKER
  CONTAINER
  KEY
  GRAFFITI
  MUSIC_KIT
  AGENT
  PATCH
  CHARM
  TOOL

  COLLECTIBLE // medals and trophies: Steam never allows trading them
  PASS
  OTHER // a type we have not mapped yet — log it when it shows up
}

// Physical location only. "Listed" became Listing.active and "sold"
// became Order.
enum ItemLocation {
  USER_INVENTORY // still in the user's Steam inventory, not deposited
  INBOUND // deposit trade sent, waiting for the user to accept
  BOT_CUSTODY // in custody — the normal state, sold or not
  OUTBOUND // delivery/return trade sent, waiting to be accepted
  WITHDRAWN // left the platform, delivered to a Steam inventory
}

// =========================
// ITEM APPLICATION
// =========================
// What is stuck on an item: a sticker, a patch or a charm.
//
// ONE ROW PER UNIT, always — never group by name with a count. Two
// copies of the same sticker can have different scrapes, and one of them
// can be worth several times the other. Grouping would destroy that
// irreversibly, since after delivery the item leaves our reach and the
// old inspect link stops working.
//
// It is also what tells apart instances that would otherwise be
// interchangeable: a clean AK and an AK with three Katowice 2014 are the
// same SkinTemplate.
model ItemApplication {
  id String @id @default(uuid(7))

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  kind ItemApplicationKind

  name     String // e.g. "Titan | Katowice 2014"
  imageUrl String?

  // The order Steam returns them in, starting at 0.
  //
  // It is NOT the physical spot on the weapon: Valve itself swaps
  // positions between the web inventory and the in-game one. It is there
  // to rebuild the list in the same order and to tell apart units with
  // the same name — not to say "it is on the grip".
  slot Int

  // Only stickers have a scrape; patches and charms stay null.
  // It does not come in the inventory: it comes from the inspect link,
  // together with float and paint seed, and so is only known once the
  // item is in custody.
  wear Float?

  createdAt DateTime @default(now())

  @@unique([itemId, kind, slot])
  @@index([itemId])
}

enum ItemApplicationKind {
  STICKER // weapon, up to 5, has a scrape
  PATCH // agent, up to 3, no scrape and cannot be removed once applied
  CHARM // charm on a weapon, no scrape
}

// =========================
// AUDIT LOG
// =========================
// A record of what happened, for settling disputes.
//
// Not to be confused with the application log: that one exists to debug
// a technical problem, lives in a file and disappears on the next
// restart. This one exists to answer "is this person telling the truth?"
// months later, and so lives in the database, is queryable per user, and
// CANNOT BE ALTERED.
//
// Immutability is enforced by a Postgres trigger, not by code
// discipline alone: a record the application can rewrite is proof of
// nothing.
//
// It stores both what succeeded and what was refused. Five attempts to
// register someone else's trade URL is a pattern that only shows up if
// the refusals are recorded.
model AuditLog {
  id String @id @default(uuid(7))

  actorType AuditActorType
  // userId, botId, or null when there is no identified actor
  actorId   String?

  // The "domain.action" convention: auth.login, user.trade_url.updated,
  // deposit.requested. A String and not an enum on purpose — a new
  // action should not require a migration.
  action  String
  outcome AuditOutcome

  targetType String? // "User", "Item", "TradeOffer"...
  targetId   String?

  // Details of the fact. For a change, store before and after: that is
  // what closes the case when someone swaps their trade URL and then
  // claims they never received the item.
  metadata Json?

  // Request context — investigating fraud without it is guesswork.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  // Suspicious-pattern scan: recent refusals
  @@index([outcome, createdAt])
}

enum AuditActorType {
  USER
  BOT
  SYSTEM // jobs and automated routines
  ANONYMOUS // no session, such as a login attempt
}

enum AuditOutcome {
  SUCCESS
  DENIED // refused by a business rule
  FAILED // technical error
}

// =========================
// LISTING (a sale offer)
// =========================
model Listing {
  id String @id @default(uuid(7))

  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  price  Decimal @db.Decimal(12, 2) // price set by the user — a contractual value
  active Boolean @default(true)

  transactions Transaction[]
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([active, price])
}

// =========================
// ORDER (a closed sale)
// =========================
// It is born when the buyer pays and dies when the item is delivered.
// In our flow those two are days apart (Valve's 7-day trade lock), so
// that interval needs an explicit owner.
// Credit rule: the seller is NOT paid on purchase — the SALE Transaction
// is born PENDING and only becomes COMPLETED when status = DELIVERED.
model Order {
  id String @id @default(uuid(7))

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  buyerId String
  buyer   User   @relation("OrderBuyer", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("OrderSeller", fields: [sellerId], references: [id])

  status OrderStatus @default(PAID)

  // Values frozen at closing — never recalculate them later.
  // The Listing can be edited again; the order cannot.
  // On own stock (seller = the platform account) feeAmount is 0: the
  // profit is the difference between price and Item.acquisitionCost, not
  // a commission.
  price        Decimal @db.Decimal(12, 2) // what the buyer paid
  feeAmount    Decimal @db.Decimal(12, 2) // the platform's commission
  sellerPayout Decimal @db.Decimal(12, 2) // price - feeAmount

  // Expected release: a copy of Item.tradeLockUntil at purchase time.
  // It is what feeds the "X days until the money lands" countdown.
  deliverableAt DateTime?
  deliveredAt   DateTime?

  // The delivery trade to the buyer (only exists once the lock expires)
  tradeOfferId String?     @unique
  tradeOffer   TradeOffer? @relation(fields: [tradeOfferId], references: [id])

  transactions Transaction[]

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([listingId])
  @@index([itemId])
  // Worker queue: orders waiting for the lock to expire
  @@index([status, deliverableAt])
}

enum OrderStatus {
  PAID // buyer paid, balance debited, the item is theirs in the virtual inventory
  AWAITING_UNLOCK // waiting for the item's trade lock to expire
  READY_TO_DELIVER // lock expired, in the bot's queue
  DELIVERING // trade sent, waiting for the buyer to accept
  DELIVERED // delivered — this is where the seller is credited
  FAILED // delivery was not possible (bot banned, user vanished...)
  REFUNDED // buyer refunded
}

// =========================
// TRANSACTION (statement / ledger)
// =========================
// Append-only: one row = one movement on the user's balance.
// Never edit an amount after creation — a refund is a new row (REFUND).
// User.balance is the materialised balance; it is only updated in the
// SAME database transaction that inserts the row here.
model Transaction {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   TransactionType
  status TransactionStatus @default(PENDING)

  // Always in USD, signed: positive credits, negative debits.
  // The fee is NOT folded in here — it becomes a separate FEE row
  // (auditing/revenue).
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal? @db.Decimal(12, 2) // post-application snapshot

  // Foreign exchange: what the user actually paid/received in their own
  // currency. This is where the FX spread metric comes from.
  // High precision because crypto uses decimal places BRL/EUR do not
  sourceAmount   Decimal? @db.Decimal(30, 10)
  sourceCurrency String? // e.g. "BRL", "BTC"
  fxRate         Decimal? @db.Decimal(18, 8) // sourceCurrency -> USD applied

  // External gateway (Stripe, EBANX, BitPay...)
  provider       String?
  providerRef    String? // the charge/payout id at the gateway
  // Idempotency key: guards against a duplicated webhook from the gateway
  idempotencyKey String? @unique

  // Internal links
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id])
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id])
  // Chains FEE/REFUND to the transaction that produced it
  parentId  String?
  parent    Transaction?  @relation("TransactionChain", fields: [parentId], references: [id])
  children  Transaction[] @relation("TransactionChain")

  description   String?
  failureReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
  @@index([provider, providerRef])
  @@index([listingId])
  @@index([orderId])
  // The seller's pending balance: SALE still PENDING, per user
  @@index([userId, type, status])
}

enum TransactionType {
  DEPOSIT // money coming in (card/PIX/crypto)
  WITHDRAWAL // cash out
  PURCHASE // debit from the buyer when a listing closes
  SALE // credit to the seller when a listing closes
  BUYOUT // fast flow: credit to the user and debit from the platform account.
  // Kept apart from SALE because the margin comes from the spread, not from a FEE.
  FEE // the platform's fee (commission, withdrawal fee)
  REFUND // a reversal of any of the above
  CHARGEBACK // a card dispute — a forced debit
  ADJUSTMENT // a manual adjustment (support/correction)
}

enum TransactionStatus {
  PENDING // waiting for the gateway to confirm
  COMPLETED // settled, balance applied
  FAILED
  CANCELED
  REVERSED // undone by a REFUND/CHARGEBACK
}

// =========================
// TRADE OFFER (a Steam trade)
// =========================
model TradeOffer {
  id String @id @default(uuid(7))

  type   TradeOfferType
  status TradeOfferStatus @default(CREATED)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  botId String
  bot   Bot    @relation(fields: [botId], references: [id])

  items TradeOfferItem[]

  // The offer's id on Steam — it only exists once sent successfully
  steamOfferId String? @unique
  // A snapshot of the trade url at send time (the user's can change later)
  tradeUrl     String?

  // Mobile confirmation (Steam Guard) on the bot's side
  confirmedAt DateTime?

  order Order?

  // The reason for going out. A return exists because the seller can
  // cancel the listing at any time, but the item only leaves once the
  // lock expires.
  reason TradeOfferReason @default(DELIVERY)

  // When the worker may try to create the offer on Steam. Filled with
  // the item's tradeLockUntil while it is locked.
  scheduledFor DateTime?

  // DEPOSIT only: the assetIds we EXPECT to receive.
  //
  // On a deposit there is no Item of ours yet — it requires a float and
  // a paintSeed, which we can only read once the skin is in custody. So
  // the offer stores only the items' addresses on Steam, and the Item
  // and TradeOfferItem rows are born when the trade is accepted.
  //
  // Remember that assetId changes with every trade: these values are
  // only valid while the items are in the user's inventory.
  requestedAssetIds String[]

  /// The prices the seller set, waiting for the items to arrive.
  intendedListings IntendedListing[]

  attempts  Int     @default(0)
  lastError String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  expiresAt   DateTime?
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([botId])
  @@index([status])
  // Worker queue: scheduled offers that can now be created
  @@index([status, scheduledFor])
}

enum TradeOfferType {
  DEPOSIT // user -> bot (handing the item over to custody)
  WITHDRAW // bot -> user (delivery to the buyer or return to the seller)
}

enum TradeOfferReason {
  DEPOSIT_INTAKE // collect the item from the seller
  DELIVERY // deliver it to the buyer
  RETURN // return it to the seller (listing cancelled or sale undone)
  WITHDRAWAL // an ordinary withdrawal from the virtual inventory
}

enum TradeOfferStatus {
  SCHEDULED // waiting for the item's trade lock to expire before it can be created.
  // Used both for delivery to the buyer and for returning a listing
  // cancelled during the lock.
  CREATED // recorded internally, not yet sent to Steam
  PENDING_CONFIRMATION // created on Steam, waiting for the bot to confirm in the mobile
  // authenticator. The offer EXISTS but the user cannot see it yet.
  SENT // confirmed and visible, waiting for the user to accept
  ACCEPTED // accepted and the items traded
  DECLINED // refused by the user
  CANCELED // cancelled by the platform
  EXPIRED // the user did not answer in time
  FAILED // a Steam error / the bot is unavailable
}

// =========================
// INTENDED LISTING
// =========================
// The price the seller set, held from the deposit request until the bot
// receives the item.
//
// Selling is one step for the user — pick, price, confirm — and two for
// us: the Trade Bot asks for the items, and the listing goes live the
// moment they arrive. That gap is minutes at best and days at worst if
// the user leaves the offer sitting on Steam, and the price has to
// survive it. Without this the price would exist only in the browser,
// and the user would be asked for it a second time after the trade they
// already accepted.
//
// One row per item, not a map on the offer: it is a price, so it is a
// Decimal like every other price in the system, and a JSON blob would
// give that up. It is also the shape a CHECK can defend.
//
// These rows are consumed when the items arrive: the worker reads them
// to create each Listing, and they are useless afterwards. They are kept
// rather than deleted so a dispute about "I listed it at X" has an
// answer.
model IntendedListing {
  id String @id @default(uuid(7))

  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)

  /// Which item this price is for. An assetId, because there is no Item
  /// yet — and it only means anything while the item sits in the user's
  /// inventory, exactly like TradeOffer.requestedAssetIds.
  assetId String

  /// What the seller wants for it, in USD like the rest of the system.
  price Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  /// One price per item per offer. A second row for the same asset would
  /// be two answers to the same question.
  @@unique([tradeOfferId, assetId])
  @@index([tradeOfferId])
}

// N:N between TradeOffer and Item (one offer can carry several items)
model TradeOfferItem {
  id String @id @default(uuid(7))

  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tradeOfferId, itemId])
  @@index([itemId])
}

// =========================
// BOT (a custody Steam account)
// =========================
// CAUTION: the password, shared_secret and identity_secret do NOT live
// here. Only the reference to the secret in the vault (env/secret
// manager).
model Bot {
  id String @id @default(uuid(7))

  steamId     String  @unique
  username    String  @unique // the bot's Steam login
  displayName String?
  tradeUrl    String?

  credentialRef String @unique // key in the secret manager, e.g. "bot/01/creds"

  status BotStatus @default(OFFLINE)

  // Capacity: a Steam inventory caps out at 1000 items
  itemCount Int @default(0)
  maxItems  Int @default(900)

  // New bots carry a 7-day trade hold / 15 days without mobile Steam Guard
  tradeHoldUntil DateTime?

  items       Item[]
  tradeOffers TradeOffer[]

  lastHeartbeat DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum BotStatus {
  ONLINE
  OFFLINE
  MAINTENANCE // out of rotation by the platform's choice
  LOCKED // trade hold / temporary Steam limitation
  BANNED
}
