generator client {
  provider = "prisma-client-js"
}

// No Prisma 7 a connection string vive em prisma.config.ts, não aqui.
datasource db {
  provider = "postgresql"
}

// =========================
// USER
// =========================
model User {
  id String @id @default(uuid(7))

  // Conta de sistema que representa a própria plataforma. Deve existir
  // exatamente UMA linha com isPlatform = true (garantir no seed).
  // É a dona dos itens comprados no fluxo rápido e a contraparte do ledger:
  // o caixa da plataforma é o balance dessa conta.
  // Toda query de "usuários reais" precisa filtrar isPlatform = false.
  isPlatform Boolean @default(false)

  // Steam
  steamId        String    @unique
  username       String
  avatarUrl      String?
  profileUrl     String?
  steamCreatedAt DateTime?

  // Carteira (sempre em USD internamente)
  balance         Decimal @default(0) @db.Decimal(12, 2)
  displayCurrency String  @default("USD")

  // Contato / conta
  email         String? @unique
  emailVerified Boolean @default(false)

  // Moderação NOSSA: nós suspendemos esta conta. Bloqueia o login.
  isBanned  Boolean @default(false)
  banReason String?

  // ---- Restrições impostas pela STEAM ----
  // Não confundir com isBanned. Quem é banido pela Steam continua sendo
  // nosso cliente e continua com direito ao que está em custódia — só perde
  // parte das operações. Tratar como banido nosso seria puni-lo duas vezes.
  //
  // Os dois campos abaixo bloqueiam coisas DIFERENTES:
  //
  // steamEconomyBan  BANNED    -> não envia nem recebe. Nada de depósito nem
  //                              de saque; a única saída é vender aqui.
  //                  PROBATION -> restrição temporária, tratar como bloqueado.
  //
  // steamVacBanned   -> não consegue ENVIAR, mas RECEBE normalmente.
  //                     Ou seja: não deposita, mas o saque funciona.
  //                     Registrado só como sinal, não bloqueia sozinho: a
  //                     API da Steam não diz de qual jogo é o VAC, e um VAC
  //                     em outro jogo não afeta os itens de CS2.
  steamEconomyBan   SteamEconomyBan @default(NONE)
  steamVacBanned    Boolean         @default(false)
  steamBanCheckedAt DateTime?

  // Trade
  tradeUrl String?

  // Relações
  items        Item[]
  listings     Listing[]
  transactions Transaction[]
  tradeOffers  TradeOffer[]
  purchases    Order[]       @relation("OrderBuyer")
  sales        Order[]       @relation("OrderSeller")

  // Metadados
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([steamEconomyBan])
}

/**
 * Espelha o campo EconomyBan de GetPlayerBans da Steam.
 */
enum SteamEconomyBan {
  NONE
  PROBATION
  BANNED
}

// =========================
// SKIN TEMPLATE
// =========================
model SkinTemplate {
  id String @id @default(uuid(7))

  // Identificação
  marketHashName String  @unique // ex: "StatTrak™ AK-47 | Redline"
  weapon         String // ex: "AK-47"
  skinName       String // ex: "Redline"
  rarity         String // ex: "Classified"
  collection     String? // ex: "The Phoenix Collection"

  variant SkinVariant @default(NORMAL)

  // Exteriores possíveis (float range da skin, não do item)
  minFloat Float @default(0)
  maxFloat Float @default(1)

  hasStickerSlots Boolean @default(false)

  // Mídia
  imageUrl    String?
  inspectLink String?

  // Cache do preço de referência externo (só exibição, sobrescrito periodicamente)
  referencePrice   Decimal?  @db.Decimal(12, 2)
  referencePriceAt DateTime?

  // ---- Whitelist do fluxo rápido (compra com desconto para revenda) ----
  // Critério: liquidez + teto de preço. Item ilíquido fica 7 dias travado
  // sem poder ser liquidado em outro mercado, então o risco de preço é real.
  // buyoutEligible é calculado por job, não editado à mão.
  buyoutEligible     Boolean   @default(false)
  buyoutDiscountPct  Decimal?  @db.Decimal(5, 2) // desconto aplicado na compra
  salesVolume30d     Int? // vendas observadas nos últimos 30 dias
  liquidityUpdatedAt DateTime?

  items     Item[]
  snapshots PriceSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyoutEligible])
}

// =========================
// HISTÓRICO DE PREÇO
// =========================
// Append-only, como Transaction. Nunca editar linha existente: cada
// leitura é um fato datado, e reescrever apagaria a prova do que foi
// exibido ao usuário naquele momento.
//
// Existe por dois motivos que não se resolvem comprando dados:
//
// 1. Reclamação. "O site me mostrou US$ 340 e vocês pagaram US$ 290" só
//    tem resposta se o preço exibido tiver sido gravado por nós. O
//    fornecedor não guarda o que respondeu há três meses.
// 2. Gráfico. Comprar arquivo histórico custa caro e recorrente;
//    acumular o nosso custa nada. Só que não se recupera depois — ou
//    começou, ou não existe.
model PriceSnapshot {
  id String @id @default(uuid(7))

  skinTemplateId String
  skinTemplate   SkinTemplate @relation(fields: [skinTemplateId], references: [id])

  /// De onde veio. Fonte e mercado são coisas diferentes: o mesmo
  /// fornecedor entrega preço de vários mercados.
  source PriceSource
  market PriceMarket

  /// Sempre USD, como o resto do sistema. Precisão maior que o ledger
  /// porque adesivo e chaveiro barato ficam abaixo de um centavo.
  price Decimal @db.Decimal(14, 4)

  /// Melhor oferta de compra e de venda, quando a fonte separa. O spread
  /// entre elas é o que indica liquidez — média esconde isso.
  bid Decimal? @db.Decimal(14, 4)
  ask Decimal? @db.Decimal(14, 4)

  /// Vendas observadas nas últimas 24h, quando a fonte informa.
  volume24h Int?

  /// Quando a FONTE apurou o preço, não quando nós gravamos. Fornecedor
  /// que serve dado de dez minutos atrás precisa ser distinguível de um
  /// que serve dado ao vivo.
  quotedAt DateTime

  capturedAt DateTime @default(now())

  /// Uma leitura por template, fonte, mercado e instante apurado. Rodar
  /// o job duas vezes não duplica a série.
  @@unique([skinTemplateId, source, market, quotedAt])
  /// Varredura do gráfico: um template, ordenado no tempo.
  @@index([skinTemplateId, market, quotedAt])
}

enum PriceSource {
  CS2SH
  STEAMWEBAPI
  /// Preço formado no nosso próprio marketplace, quando houver volume.
  INTERNO
}

enum PriceMarket {
  BUFF163
  YOUPIN
  CSFLOAT
  SKINPORT
  C5GAME
  DMARKET
  WAXPEER
  BITSKINS
  STEAM
  NEXTSKINS
}

enum SkinVariant {
  NORMAL
  STATTRAK
  SOUVENIR
}

// =========================
// ITEM (instância real)
// =========================
model Item {
  id String @id @default(uuid(7))

  templateId String
  template   SkinTemplate @relation(fields: [templateId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // O que este item é. Vem da tag Type da Steam, não do nome.
  category ItemCategory

  // ATENÇÃO: assetId MUDA a cada troca de inventário. É o endereço atual do
  // item na Steam, não a identidade dele — por isso não é @unique.
  assetId String // ID atual do item na Steam (mutável)

  // Só armas, facas e luvas têm padrão único. Caixa, adesivo e agente são
  // fungíveis: um exemplar é idêntico a outro, e estes campos ficam nulos.
  // Um CHECK na migration garante que categoria com padrão único tenha os
  // quatro preenchidos — nulo ali significaria item impossível de
  // identificar depois de uma troca.
  //
  // Quando preenchidos, a identidade estável do item é a combinação
  // float + paintSeed + paintIndex + defIndex.
  float      Float?
  paintSeed  Int?
  paintIndex Int?
  defIndex   Int? // define a arma em si (imutável)

  // Onde o item está FISICAMENTE. Não confundir com quem é o dono (ownerId)
  // nem com estar vendido (Order) — no nosso fluxo o item passa quase todo o
  // ciclo de vida parado em BOT_CUSTODY, inclusive depois de vendido.
  location ItemLocation @default(USER_INVENTORY)
  botId    String? // se estiver custodiado por um bot
  bot      Bot?         @relation(fields: [botId], references: [id])

  // Trade Protection da Valve: 7 dias a cada vez que o item é RECEBIDO.
  // Enquanto estiver no futuro, o bot não consegue enviar o item para ninguém.
  // Preenchido quando o bot aceita a troca de depósito.
  tradeLockUntil DateTime?

  // Como o item entrou na custódia.
  // PLATFORM_BUYOUT = estoque próprio: compramos com desconto para revender.
  // Nesse caso acquisitionCost é obrigatório na prática — sem ele não há
  // como calcular margem nem saber se o desconto está calibrado.
  acquisitionType ItemAcquisition @default(USER_DEPOSIT)
  acquisitionCost Decimal?        @db.Decimal(12, 2) // em USD, só em buyout
  acquiredAt      DateTime?

  applications    ItemApplication[]
  listing         Listing?
  tradeOfferItems TradeOfferItem[]
  orders          Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([templateId])
  @@index([location])
  @@index([botId])
  @@index([assetId]) // lookup ao reconciliar inventário, mas não é único
  @@index([acquisitionType]) // relatório de estoque próprio
  @@index([category])
  // Identidade estável do item — usada para reencontrá-lo depois de uma troca
  @@index([defIndex, paintIndex, paintSeed, float])
  // Fila de entrega: itens liberáveis a partir de tal momento
  @@index([location, tradeLockUntil])
}

enum ItemAcquisition {
  USER_DEPOSIT // usuário depositou para vender — o item não é nosso
  PLATFORM_BUYOUT // compramos do usuário no fluxo rápido — estoque próprio
}

/**
 * Derivada da tag Type da Steam. Granular de propósito: além de decidir
 * quais campos o item precisa, é por aqui que a vitrine filtra.
 * As oito primeiras têm padrão único (float e paint seed). O resto é
 * fungível — um exemplar é idêntico a outro.
 */
enum ItemCategory {
  RIFLE
  PISTOL
  SMG
  SNIPER_RIFLE
  SHOTGUN
  MACHINEGUN
  KNIFE
  GLOVES

  STICKER
  CONTAINER
  KEY
  GRAFFITI
  MUSIC_KIT
  AGENT
  PATCH
  CHARM
  TOOL

  COLLECTIBLE // medalhas e troféus: a Steam nunca deixa trocar
  PASS
  OTHER // tipo que ainda não mapeamos — logar quando aparecer
}

// Só localização física. "Listado" virou Listing.active e "vendido" virou Order.
enum ItemLocation {
  USER_INVENTORY // ainda no inventário Steam do usuário, não depositado
  INBOUND // troca de depósito enviada, aguardando o usuário aceitar
  BOT_CUSTODY // em custódia — estado normal, inclusive após vendido
  OUTBOUND // troca de entrega/devolução enviada, aguardando aceite
  WITHDRAWN // saiu da plataforma, entregue a um inventário Steam
}

// =========================
// ITEM APPLICATION
// =========================
// O que está colado num item: sticker, patch ou chaveiro.
//
// UMA LINHA POR UNIDADE, sempre — nunca agrupar por nome com uma
// contagem. Duas cópias do mesmo sticker podem ter raspagens diferentes,
// e uma delas pode valer múltiplos da outra. Agrupar destruiria isso de
// forma irreversível, já que depois da entrega o item sai do nosso
// alcance e o inspect link antigo deixa de funcionar.
//
// É também o que diferencia exemplares que, sem isso, seriam
// intercambiáveis: uma AK limpa e uma AK com três Katowice 2014 são o
// mesmo SkinTemplate.
model ItemApplication {
  id String @id @default(uuid(7))

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  kind ItemApplicationKind

  name     String // ex: "Titan | Katowice 2014"
  imageUrl String?

  // Ordem em que a Steam devolve, começando em 0.
  //
  // NÃO é o lugar físico na arma: a própria Valve inverte posições entre
  // o inventário web e o do jogo. Serve para reconstruir a lista na mesma
  // ordem e para distinguir unidades de mesmo nome — não para dizer
  // "está no cabo".
  slot Int

  // Só sticker tem raspagem; patch e chaveiro ficam nulos.
  // Não vem no inventário: sai do inspect link, junto com float e paint
  // seed, e por isso só é conhecido depois que o item entra em custódia.
  wear Float?

  createdAt DateTime @default(now())

  @@unique([itemId, kind, slot])
  @@index([itemId])
}

enum ItemApplicationKind {
  STICKER // arma, até 5, tem raspagem
  PATCH // agente, até 3, sem raspagem e não sai depois de aplicado
  CHARM // chaveiro em arma, sem raspagem
}

// =========================
// AUDIT LOG
// =========================
// Registro do que aconteceu, para resolver disputa.
//
// Não confundir com log de aplicação: aquele existe para depurar problema
// técnico, vive em arquivo e some no próximo restart. Este existe para
// responder "essa pessoa está dizendo a verdade?" meses depois, e por isso
// vive no banco, é consultável por usuário e NÃO PODE SER ALTERADO.
//
// A imutabilidade é garantida por trigger no Postgres, não só por
// disciplina de código: um registro que a aplicação pode reescrever não
// serve como prova de nada.
//
// Guarda tanto o que deu certo quanto o que foi recusado. Cinco tentativas
// de cadastrar trade URL de terceiros é um padrão que só aparece se as
// recusas forem registradas.
model AuditLog {
  id String @id @default(uuid(7))

  actorType AuditActorType
  // userId, botId ou nulo quando não há ator identificado
  actorId   String?

  // Convenção "dominio.acao": auth.login, user.trade_url.updated,
  // deposit.requested. String e não enum de propósito — ação nova não
  // deveria exigir migration.
  action  String
  outcome AuditOutcome

  targetType String? // "User", "Item", "TradeOffer"...
  targetId   String?

  // Detalhes do fato. Para alteração, guardar antes e depois: é o que
  // fecha o caso quando alguém troca a trade URL e depois alega não ter
  // recebido o item.
  metadata Json?

  // Contexto da requisição — investigar golpe sem isso é adivinhação.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  // Varredura de padrão suspeito: recusas recentes
  @@index([outcome, createdAt])
}

enum AuditActorType {
  USER
  BOT
  SYSTEM // jobs e rotinas automáticas
  ANONYMOUS // sem sessão, como uma tentativa de login
}

enum AuditOutcome {
  SUCCESS
  DENIED // recusado por regra de negócio
  FAILED // erro técnico
}

// =========================
// LISTING (anúncio de venda)
// =========================
model Listing {
  id String @id @default(uuid(7))

  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  price  Decimal @db.Decimal(12, 2) // preço definido pelo usuário — valor contratual
  active Boolean @default(true)

  transactions Transaction[]
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([active, price])
}

// =========================
// ORDER (venda fechada)
// =========================
// Nasce quando o comprador paga e morre quando o item é entregue.
// No nosso fluxo essas duas coisas são separadas por dias (trade lock de 7
// dias da Valve), então esse intervalo precisa de um dono explícito.
// Regra de crédito: o vendedor NÃO recebe na compra — a Transaction de SALE
// nasce PENDING e só vira COMPLETED quando status = DELIVERED.
model Order {
  id String @id @default(uuid(7))

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  buyerId String
  buyer   User   @relation("OrderBuyer", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("OrderSeller", fields: [sellerId], references: [id])

  status OrderStatus @default(PAID)

  // Valores congelados no fechamento — não recalcular depois.
  // A Listing pode ser reeditada; o pedido não.
  // No estoque próprio (seller = conta plataforma) feeAmount é 0: o lucro
  // é a diferença entre price e Item.acquisitionCost, não uma comissão.
  price        Decimal @db.Decimal(12, 2) // o que o comprador pagou
  feeAmount    Decimal @db.Decimal(12, 2) // comissão da plataforma
  sellerPayout Decimal @db.Decimal(12, 2) // price - feeAmount

  // Previsão de liberação: cópia de Item.tradeLockUntil no momento da compra.
  // É o que alimenta o contador "faltam X dias para o dinheiro cair".
  deliverableAt DateTime?
  deliveredAt   DateTime?

  // Troca de entrega ao comprador (só existe depois do lock expirar)
  tradeOfferId String?     @unique
  tradeOffer   TradeOffer? @relation(fields: [tradeOfferId], references: [id])

  transactions Transaction[]

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([listingId])
  @@index([itemId])
  // Fila do worker: pedidos esperando o lock expirar
  @@index([status, deliverableAt])
}

enum OrderStatus {
  PAID // comprador pagou, saldo debitado, item já é dele no inventário virtual
  AWAITING_UNLOCK // aguardando o trade lock do item expirar
  READY_TO_DELIVER // lock expirou, na fila do bot
  DELIVERING // troca enviada, aguardando o comprador aceitar
  DELIVERED // entregue — é aqui que o vendedor é creditado
  FAILED // entrega não foi possível (bot banido, usuário sumiu...)
  REFUNDED // comprador estornado
}

// =========================
// TRANSACTION (extrato / ledger)
// =========================
// Append-only: uma linha = um movimento no saldo do usuário.
// Nunca editar valor depois de criada — estorno é uma nova linha (REFUND).
// User.balance é o saldo materializado; só é atualizado na MESMA transação
// de banco que insere a linha aqui.
model Transaction {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   TransactionType
  status TransactionStatus @default(PENDING)

  // Valor sempre em USD, com sinal: positivo credita, negativo debita.
  // Taxa NÃO fica embutida aqui — vira uma linha FEE separada (auditoria/receita).
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal? @db.Decimal(12, 2) // snapshot pós-aplicação

  // Câmbio: o que o usuário efetivamente pagou/recebeu na moeda dele.
  // É daqui que sai a métrica de spread cambial.
  // Precisão alta porque cripto usa casas decimais que BRL/EUR não usam
  sourceAmount   Decimal? @db.Decimal(30, 10)
  sourceCurrency String? // ex: "BRL", "BTC"
  fxRate         Decimal? @db.Decimal(18, 8) // sourceCurrency -> USD aplicado

  // Gateway externo (Stripe, EBANX, BitPay...)
  provider       String?
  providerRef    String? // id da cobrança/payout no gateway
  // Chave de idempotência: protege contra webhook duplicado do gateway
  idempotencyKey String? @unique

  // Vínculos internos
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id])
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id])
  // Encadeia FEE/REFUND na transação que a originou
  parentId  String?
  parent    Transaction?  @relation("TransactionChain", fields: [parentId], references: [id])
  children  Transaction[] @relation("TransactionChain")

  description   String?
  failureReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
  @@index([provider, providerRef])
  @@index([listingId])
  @@index([orderId])
  // Saldo a liberar do vendedor: SALE ainda PENDING por usuário
  @@index([userId, type, status])
}

enum TransactionType {
  DEPOSIT // entrada de dinheiro (cartão/PIX/cripto)
  WITHDRAWAL // saque
  PURCHASE // débito do comprador ao fechar uma listing
  SALE // crédito do vendedor ao fechar uma listing
  BUYOUT // fluxo rápido: crédito ao usuário e débito da conta plataforma.
  // Separado de SALE porque a margem sai do spread, não de FEE.
  FEE // taxa da plataforma (comissão, taxa de saque)
  REFUND // estorno de qualquer uma das acima
  CHARGEBACK // contestação no cartão — débito forçado
  ADJUSTMENT // ajuste manual (suporte/correção)
}

enum TransactionStatus {
  PENDING // aguardando confirmação do gateway
  COMPLETED // liquidada, saldo aplicado
  FAILED
  CANCELED
  REVERSED // desfeita por REFUND/CHARGEBACK
}

// =========================
// TRADE OFFER (troca Steam)
// =========================
model TradeOffer {
  id String @id @default(uuid(7))

  type   TradeOfferType
  status TradeOfferStatus @default(CREATED)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  botId String
  bot   Bot    @relation(fields: [botId], references: [id])

  items TradeOfferItem[]

  // Id da oferta na Steam — só existe depois de enviada com sucesso
  steamOfferId String? @unique
  // Snapshot da trade url no momento do envio (a do usuário pode mudar depois)
  tradeUrl     String?

  // Confirmação mobile (Steam Guard) do lado do bot
  confirmedAt DateTime?

  order Order?

  // Motivo da saída. Devolução existe porque o vendedor pode cancelar o
  // anúncio a qualquer momento, mas o item só sai depois do lock expirar.
  reason TradeOfferReason @default(DELIVERY)

  // Quando o worker pode tentar criar a oferta na Steam. Preenchido com o
  // tradeLockUntil do item enquanto ele estiver travado.
  scheduledFor DateTime?

  // Só em DEPOSIT: os assetIds que ESPERAMOS receber.
  //
  // No depósito ainda não existe Item nosso — ele exige float e paintSeed,
  // que só conseguimos ler depois que a skin está em custódia. Então a
  // oferta guarda apenas os endereços dos itens na Steam, e os Item e
  // TradeOfferItem nascem quando a troca é aceita.
  //
  // Lembrando que assetId muda a cada troca: estes valores só valem
  // enquanto os itens estiverem no inventário do usuário.
  requestedAssetIds String[]

  attempts  Int     @default(0)
  lastError String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  expiresAt   DateTime?
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([botId])
  @@index([status])
  // Fila do worker: ofertas agendadas que já podem ser criadas
  @@index([status, scheduledFor])
}

enum TradeOfferType {
  DEPOSIT // usuário -> bot (entrega do item para custódia)
  WITHDRAW // bot -> usuário (entrega ao comprador ou devolução ao vendedor)
}

enum TradeOfferReason {
  DEPOSIT_INTAKE // recolher o item do vendedor
  DELIVERY // entregar ao comprador
  RETURN // devolver ao vendedor (anúncio cancelado ou venda desfeita)
  WITHDRAWAL // saque comum do inventário virtual
}

enum TradeOfferStatus {
  SCHEDULED // aguardando o trade lock do item expirar para poder ser criada.
  // Usado tanto na entrega ao comprador quanto na devolução de anúncio
  // cancelado durante o lock.
  CREATED // registrada internamente, ainda não enviada à Steam
  PENDING_CONFIRMATION // criada na Steam, aguardando o bot confirmar no mobile
  // authenticator. A oferta EXISTE mas o usuário ainda não a vê.
  SENT // confirmada e visível, aguardando o usuário aceitar
  ACCEPTED // aceita e itens trocados
  DECLINED // recusada pelo usuário
  CANCELED // cancelada pela plataforma
  EXPIRED // usuário não respondeu a tempo
  FAILED // erro na Steam / bot indisponível
}

// N:N entre TradeOffer e Item (uma oferta pode levar vários itens)
model TradeOfferItem {
  id String @id @default(uuid(7))

  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tradeOfferId, itemId])
  @@index([itemId])
}

// =========================
// BOT (conta Steam de custódia)
// =========================
// ATENÇÃO: senha, shared_secret e identity_secret NÃO ficam aqui.
// Só a referência ao segredo no cofre (env/secret manager).
model Bot {
  id String @id @default(uuid(7))

  steamId     String  @unique
  username    String  @unique // login Steam do bot
  displayName String?
  tradeUrl    String?

  credentialRef String @unique // chave no secret manager, ex: "bot/01/creds"

  status BotStatus @default(OFFLINE)

  // Capacidade: inventário Steam trava em 1000 itens
  itemCount Int @default(0)
  maxItems  Int @default(900)

  // Bots novos ficam com trade hold de 7 dias / 15 dias sem Steam Guard mobile
  tradeHoldUntil DateTime?

  items       Item[]
  tradeOffers TradeOffer[]

  lastHeartbeat DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum BotStatus {
  ONLINE
  OFFLINE
  MAINTENANCE // fora de rotação por escolha da plataforma
  LOCKED // trade hold / limitação temporária da Steam
  BANNED
}
