{
  "extends": "./tsconfig.json",
  // Só src/ entra no build. Qualquer .ts fora dela (prisma.config.ts,
  // prisma/seed.ts) empurraria o rootDir para cima e a saída viraria
  // dist/src/main.js, quebrando o start:prod.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
