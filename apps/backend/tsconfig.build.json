{
  "extends": "./tsconfig.json",
  // Only src/ goes into the build. Any .ts outside it (prisma.config.ts,
  // prisma/seed.ts) would push rootDir upwards and the output would
  // become dist/src/main.js, breaking start:prod.
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "src/test-utils/**"
  ]
}
