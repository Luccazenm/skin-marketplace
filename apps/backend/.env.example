# Copie para .env e ajuste. Nenhum valor real deve ser commitado.

NODE_ENV=development
PORT=3000

# Origem do frontend liberada no CORS. Aceita lista separada por vírgula.
CORS_ORIGIN=http://localhost:5173

# Postgres (docker-compose sobe com estas credenciais em dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_marketplace

# Redis — usado pelo BullMQ (fila de entrega quando o trade lock expira)
REDIS_URL=redis://localhost:6379

# Endereço público desta API. A Steam mostra este domínio na tela de login
# e devolve o usuário para API_URL/api/auth/steam/return.
API_URL=http://localhost:3000

# Para onde o usuário é mandado depois do login concluído
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Ainda não usados pelo código. Descomente conforme cada integração entrar.
# ---------------------------------------------------------------------------

# Assina os tokens de sessão. OBRIGATÓRIO — não há valor padrão.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade da sessão em segundos. Vale para o token e para o cookie.
JWT_EXPIRES_IN_SECONDS=604800

# true em produção (exige HTTPS). false só em dev local.
COOKIE_SECURE=false

# Steam Web API — opcional. Serve para preencher nome e avatar do perfil.
# O login NÃO depende dela: quem autentica é o OpenID.
# Obtenha em https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# Gateways de pagamento
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EBANX_INTEGRATION_KEY=

# Credenciais dos bots NUNCA ficam aqui nem no banco.
# Isto é só o endereço do cofre que guarda shared_secret / identity_secret.
# BOT_SECRETS_PROVIDER=
# BOT_SECRETS_PREFIX=
