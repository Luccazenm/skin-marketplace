# Copy to .env and adjust. No real value may ever be committed.

NODE_ENV=development
PORT=3000

# The frontend origin allowed by CORS. Accepts a comma-separated list.
CORS_ORIGIN=http://localhost:5173

# Postgres (docker-compose brings it up with these credentials in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_marketplace

# Redis — used by BullMQ (the delivery queue for when the trade lock expires)
REDIS_URL=redis://localhost:6379

# This API's public address. Steam shows this domain on the login screen
# and returns the user to API_URL/api/auth/steam/return.
API_URL=http://localhost:3000

# Where the user is sent once the login is complete
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Not used by the code yet. Uncomment as each integration lands.
# ---------------------------------------------------------------------------

# Signs the session tokens. REQUIRED — there is no default value.
# Generate yours with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session lifetime in seconds. Governs both the token and the cookie.
JWT_EXPIRES_IN_SECONDS=604800

# The platform's commission, as a percentage of the sale price. It is
# what the seller is charged, so it lives here and not in the frontend:
# a copy in the browser would keep quoting the old number the day this
# changes.
PLATFORM_FEE_PERCENT=5

# Where Steam calls go out from, comma-separated. Steam limits the
# inventory endpoint PER IP, so this list is the site's inventory
# capacity: one route is roughly 900 reads an hour, ten is ten times
# that. Each entry is a local source address to bind to, or a proxy to
# route through.
#
# Empty means one route — the machine's own address. That is the default
# and needs no configuration; filling this in is how capacity grows,
# without a code change.
#   STEAM_EGRESS=203.0.113.7,203.0.113.8,http://user:pass@proxy:8080
STEAM_EGRESS=

# true in production (requires HTTPS). false only in local development.
COOKIE_SECURE=false

# Steam Web API — optional. It fills in the profile's name and avatar.
# Login does NOT depend on it: the OpenID is what authenticates.
# Get one at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# Payment gateways
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EBANX_INTEGRATION_KEY=

# Bot credentials NEVER live here, nor in the database.
# This is only the address of the vault holding shared_secret /
# identity_secret.
# BOT_SECRETS_PROVIDER=
# BOT_SECRETS_PREFIX=

# ---------------------------------------------------------------------
# Price source — cs2.sh (Developer plan)
# ---------------------------------------------------------------------
# Bid and ask across BUFF, Youpin, CSFloat, Skinport, Steam and C5Game.
# BUFF is the reference the pricing rules are anchored on; Steam is
# collected but never used as a reference, because balance there cannot
# be withdrawn and its prices run ~40% high.
#
# /v1/prices/latest takes no filter: it returns every item, about 40k of
# them and 50MB, so it is a scheduled bulk read, never a per-item call.
CS2SH_API_KEY=
