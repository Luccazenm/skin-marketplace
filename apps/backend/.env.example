# Copie para .env e ajuste. Nenhum valor real deve ser commitado.

NODE_ENV=development
PORT=3000

# Origem do frontend liberada no CORS. Aceita lista separada por vírgula.
CORS_ORIGIN=http://localhost:5173

# Postgres (docker-compose sobe com estas credenciais em dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_marketplace

# Redis — usado pelo BullMQ (fila de entrega quando o trade lock expira)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Ainda não usados pelo código. Descomente conforme cada integração entrar.
# ---------------------------------------------------------------------------

# Steam (login e leitura de inventário)
# STEAM_API_KEY=
# STEAM_RETURN_URL=http://localhost:3000/api/auth/steam/return

# Gateways de pagamento
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EBANX_INTEGRATION_KEY=

# Credenciais dos bots NUNCA ficam aqui nem no banco.
# Isto é só o endereço do cofre que guarda shared_secret / identity_secret.
# BOT_SECRETS_PROVIDER=
# BOT_SECRETS_PREFIX=
